{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Alya",
  "scopeName": "source.alya",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.alya",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.alya",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.alya",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.alya",
          "match": "\\b(if|else|while|for|in|return|break|continue|match|async|await)\\b"
        },
        {
          "name": "keyword.declaration.alya",
          "match": "\\b(fn|let|mut|struct|enum|impl|trait|type|pub|use|mod|const|static)\\b"
        },
        {
          "name": "variable.language.alya",
          "match": "\\b(self|Self)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.alya",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.alya",
          "match": "\\bnil\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.alya",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.alya",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.alya",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.alya" },
            "2": { "name": "entity.name.function.alya" }
          }
        }
      ]
    }
  }
}
