{
  "$schema": "vscode://schemas/color-theme",
  "name": "Alya Light",
  "type": "light",
  "colors": {
    "focusBorder": "#0284c7",
    "foreground": "#1e293b",

    "editor.background": "#f8fafc",
    "editor.foreground": "#1e293b",
    "editor.lineHighlightBackground": "#f1f5f9",
    "editorCursor.foreground": "#0284c7",
    "editorLineNumber.foreground": "#94a3b8",
    "editorLineNumber.activeForeground": "#0284c7",
    "editor.selectionBackground": "#bae6fd",
    "editor.inactiveSelectionBackground": "#e0f2fe",
    "editorWhitespace.foreground": "#cbd5e1",
    "editorIndentGuide.background1": "#e2e8f0",
    "editorIndentGuide.activeBackground1": "#0284c7",
    "editorInlayHint.foreground": "#64748b",
    "editorInlayHint.background": "#f1f5f9",

    "editorBracketHighlight.foreground1": "#0284c7",
    "editorBracketHighlight.foreground2": "#7c3aed",
    "editorBracketHighlight.foreground3": "#059669",
    "editorBracketHighlight.foreground4": "#4f46e5",
    "editorBracketHighlight.foreground5": "#0369a1",
    "editorBracketHighlight.foreground6": "#a21caf",
    "editorBracketHighlight.unexpectedBracket.foreground": "#dc2626",
    "editorBracketPairGuide.background1": "#0284c733",
    "editorBracketPairGuide.background2": "#7c3aed33",
    "editorBracketPairGuide.background3": "#05966933",
    "editorBracketPairGuide.background4": "#4f46e533",
    "editorBracketPairGuide.background5": "#0369a133",
    "editorBracketPairGuide.background6": "#a21caf33",
    "editorBracketPairGuide.activeBackground1": "#0284c7",
    "editorBracketPairGuide.activeBackground2": "#7c3aed",
    "editorBracketPairGuide.activeBackground3": "#059669",
    "editorBracketPairGuide.activeBackground4": "#4f46e5",
    "editorBracketPairGuide.activeBackground5": "#0369a1",
    "editorBracketPairGuide.activeBackground6": "#a21caf",

    "sideBar.background": "#f1f5f9",
    "sideBar.foreground": "#1e293b",
    "sideBar.border": "#e2e8f0",
    "activityBar.background": "#f1f5f9",
    "activityBar.foreground": "#0284c7",
    "activityBar.inactiveForeground": "#94a3b8",
    "activityBar.border": "#e2e8f0",
    "statusBar.background": "#e2e8f0",
    "statusBar.foreground": "#1e293b",
    "statusBar.border": "#cbd5e1",
    "tab.activeBackground": "#f8fafc",
    "tab.activeForeground": "#0f172a",
    "tab.inactiveBackground": "#f1f5f9",
    "tab.inactiveForeground": "#64748b",
    "tab.border": "#e2e8f0",
    "panel.background": "#f1f5f9",
    "panel.border": "#e2e8f0",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#cbd5e1",
    "editorHoverWidget.background": "#ffffff",
    "editorHoverWidget.border": "#cbd5e1",
    "button.background": "#0284c7",
    "button.foreground": "#ffffff",
    "input.background": "#ffffff",
    "input.border": "#cbd5e1",
    "input.foreground": "#1e293b"
  },
  "tokenColors": [
    {
      "scope": ["comment", "comment.block", "comment.line"],
      "settings": { "foreground": "#64748b", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "keyword.control", "keyword.declaration", "keyword.operator", "keyword.other", "storage"],
      "settings": { "foreground": "#7c3aed" }
    },
    {
      "scope": ["keyword.other.unit-testing"],
      "settings": { "foreground": "#0284c7" }
    },
    {
      "scope": ["string", "string.quoted", "string.interpolated"],
      "settings": { "foreground": "#047857" }
    },
    {
      "scope": ["punctuation.definition.string", "punctuation.section.interpolation"],
      "settings": { "foreground": "#059669" }
    },
    {
      "scope": ["constant.numeric", "constant.character.escape"],
      "settings": { "foreground": "#b45309" }
    },
    {
      "scope": ["constant.language"],
      "settings": { "foreground": "#c026d3" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#0369a1" }
    },
    {
      "scope": ["entity.name.type", "support.type", "support.class"],
      "settings": { "foreground": "#0e7490" }
    },
    {
      "scope": ["entity.other.attribute-name", "entity.name.tag"],
      "settings": { "foreground": "#a21caf" }
    },
    {
      "scope": ["variable.language"],
      "settings": { "foreground": "#0f172a", "fontStyle": "bold" }
    },
    {
      "scope": ["variable.parameter", "variable.other"],
      "settings": { "foreground": "#475569" }
    },
    {
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#64748b" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#dc2626" }
    }
  ],
  "semanticTokenColors": {
    "type": "#0e7490",
    "class": "#0e7490",
    "enum": "#0e7490",
    "enumMember": "#0284c7",
    "struct": "#0e7490",
    "interface": "#475569",
    "typeParameter": "#0e7490",
    "parameter": "#c026d3",
    "variable": "#334155",
    "property": "#0284c7",
    "function": "#0369a1",
    "method": "#0369a1",
    "keyword": "#7c3aed",
    "string": "#047857",
    "number": "#b45309",
    "operator": "#64748b"
  }
}
