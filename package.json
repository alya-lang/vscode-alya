{
  "name": "alya-lsp",
  "displayName": "Alya",
  "description": "Language Server Protocol (LSP), Debug Adapter Protocol (DAP), native assembly viewer, Test Explorer, formatting, CodeLens, syntax highlighting, and brand file icons for Alya",
  "version": "0.12.0",
  "publisher": "alya-lang",
  "author": {
    "name": "Taiizor",
    "email": "taiizor@vegalya.com",
    "url": "https://github.com/Taiizor"
  },
  "license": "MIT",
  "homepage": "https://github.com/alya-lang/vscode-alya#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/alya-lang/vscode-alya.git"
  },
  "bugs": {
    "url": "https://github.com/alya-lang/vscode-alya/issues"
  },
  "keywords": [
    "alya",
    "lsp",
    "language-server",
    "syntax-highlighting",
    "programming-language",
    "assembly",
    "testing"
  ],
  "icon": "./icons/alya-icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Testing"
  ],
  "activationEvents": [
    "onLanguage:alya"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "languages": [
      {
        "id": "alya",
        "aliases": [
          "Alya",
          "alya"
        ],
        "extensions": [
          ".alya"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./icons/alya-file-dark.svg",
          "light": "./icons/alya-file-light.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "alya",
        "scopeName": "source.alya",
        "path": "./syntaxes/alya.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "alya-file-icons",
        "label": "Alya File Icons",
        "path": "./icons/alya-file-icon-theme.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "alya",
        "required": ["task"],
        "properties": {
          "task": {
            "type": "string",
            "enum": ["run", "test", "build", "check", "fmt"],
            "description": "Alya command to run: run (current file), test, build, check, or fmt."
          },
          "file": {
            "type": "string",
            "description": "File for the run task (defaults to ${file} at execution time)."
          },
          "args": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Extra CLI args appended after the built-in ones."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "$alya",
        "owner": "alya",
        "fileLocation": "absolute",
        "pattern": [
          {
            "regexp": "^(error|warning): (.*)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^\\s+--> (.+):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "themes": [
      {
        "label": "Alya Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/alya-dark-color-theme.json"
      },
      {
        "label": "Alya Light",
        "uiTheme": "vs",
        "path": "./themes/alya-light-color-theme.json"
      }
    ],
    "snippets": [
      {
        "language": "alya",
        "path": "./snippets/alya.json"
      }
    ],
    "commands": [
      {
        "command": "alya.runFile",
        "title": "%command.runFile%",
        "icon": "$(play)"
      },
      {
        "command": "alya.runFileWithMemTrace",
        "title": "%command.runFileWithMemTrace%",
        "icon": "$(pulse)"
      },
      {
        "command": "alya.runTest",
        "title": "%command.runTest%",
        "icon": "$(beaker)"
      },
      {
        "command": "alya.viewAssembly",
        "title": "%command.viewAssembly%",
        "icon": "$(file-binary)"
      },
      {
        "command": "alya.viewAst",
        "title": "%command.viewAst%",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "alya.viewTokens",
        "title": "%command.viewTokens%",
        "icon": "$(symbol-key)"
      },
      {
        "command": "alya.showMenu",
        "title": "%command.showMenu%"
      },
      {
        "command": "alya.restartLsp",
        "title": "%command.restartLsp%",
        "icon": "$(refresh)"
      },
      {
        "command": "alya.openRepl",
        "title": "%command.openRepl%",
        "icon": "$(terminal)"
      },
      {
        "command": "alya.formatDocument",
        "title": "%command.formatDocument%"
      },
      {
        "command": "alya.showDoc",
        "title": "%command.showDoc%",
        "icon": "$(book)"
      },
      {
        "command": "alya.generateDocstring",
        "title": "%command.generateDocstring%",
        "icon": "$(comment)"
      },
      {
        "command": "alya.lintFile",
        "title": "%command.lintFile%",
        "icon": "$(search)"
      },
      {
        "command": "alya.lintFix",
        "title": "%command.lintFix%",
        "icon": "$(wrench)"
      },
      {
        "command": "alya.runTestAtCursor",
        "title": "%command.runTestAtCursor%",
        "icon": "$(beaker)"
      },
      {
        "command": "alya.debugTest",
        "title": "%command.debugTest%",
        "icon": "$(debug-alt)"
      },
      {
        "command": "alya.debugFile",
        "title": "%command.debugFile%",
        "icon": "$(debug-alt)"
      },
      {
        "command": "alya.rerunFailedTests",
        "title": "%command.rerunFailedTests%",
        "icon": "$(refresh)"
      },
      {
        "command": "alya.showEnvInfo",
        "title": "%command.showEnvInfo%"
      },
      {
        "command": "alya.checkCompiler",
        "title": "%command.checkCompiler%"
      },
      {
        "command": "alya.registerSystemFileIcons",
        "title": "%command.registerSystemFileIcons%",
        "icon": "$(file)"
      }
    ],
    "keybindings": [
      {
        "command": "alya.generateDocstring",
        "key": "ctrl+alt+d",
        "when": "editorTextFocus && editorLangId == alya"
      }
    ],
    "breakpoints": [
      {
        "language": "alya"
      }
    ],
    "debuggers": [
      {
        "type": "alya",
        "label": "%debugger.label%",
        "languages": [
          "alya"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "%debugger.program.description%",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "%debugger.stopOnEntry.description%",
                "default": false
              },
              "memTrace": {
                "type": "boolean",
                "description": "%debugger.memTrace.description%",
                "default": false
              },
              "args": {
                "type": "array",
                "description": "%debugger.args.description%",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "%debugger.cwd.description%",
                "default": "${workspaceFolder}"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "alya",
            "request": "launch",
            "name": "Alya: Launch Current File",
            "program": "${file}",
            "stopOnEntry": false,
            "memTrace": false
          },
          {
            "type": "alya",
            "request": "launch",
            "name": "Alya: Run Tests",
            "program": "${workspaceFolder}/tests",
            "stopOnEntry": false,
            "args": [
              "test"
            ]
          },
          {
            "type": "alya",
            "request": "launch",
            "name": "Alya: Run with Memory Leak Trace",
            "program": "${file}",
            "stopOnEntry": false,
            "memTrace": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "%debugger.snippet.launch.label%",
            "description": "%debugger.snippet.launch.description%",
            "body": {
              "type": "alya",
              "request": "launch",
              "name": "Alya: Launch Current File",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false,
              "memTrace": false
            }
          },
          {
            "label": "%debugger.snippet.tests.label%",
            "description": "%debugger.snippet.tests.description%",
            "body": {
              "type": "alya",
              "request": "launch",
              "name": "Alya: Run Tests",
              "program": "^\"\\${workspaceFolder}/tests\"",
              "stopOnEntry": false,
              "args": [
                "test"
              ]
            }
          },
          {
            "label": "%debugger.snippet.memTrace.label%",
            "description": "%debugger.snippet.memTrace.description%",
            "body": {
              "type": "alya",
              "request": "launch",
              "name": "Alya: Run with Memory Leak Trace",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false,
              "memTrace": true
            }
          }
        ]
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "alya.registerSystemFileIcons",
          "when": "isWindows || isLinux"
        }
      ],
      "editor/title": [
        {
          "command": "alya.runFile",
          "when": "resourceExtname == .alya",
          "group": "navigation@1"
        },
        {
          "command": "alya.debugFile",
          "when": "resourceExtname == .alya",
          "group": "navigation@1.1"
        },
        {
          "command": "alya.runFileWithMemTrace",
          "when": "resourceExtname == .alya",
          "group": "navigation@1.5"
        },
        {
          "command": "alya.runTest",
          "when": "resourceExtname == .alya",
          "group": "navigation@2"
        },
        {
          "command": "alya.viewAssembly",
          "when": "resourceExtname == .alya",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "alya.runFile",
          "when": "resourceExtname == .alya",
          "group": "1_alya@1"
        },
        {
          "command": "alya.debugFile",
          "when": "resourceExtname == .alya",
          "group": "1_alya@1.1"
        },
        {
          "command": "alya.runFileWithMemTrace",
          "when": "resourceExtname == .alya",
          "group": "1_alya@1.5"
        },
        {
          "command": "alya.runTest",
          "when": "resourceExtname == .alya",
          "group": "1_alya@2"
        },
        {
          "command": "alya.runTestAtCursor",
          "when": "resourceExtname == .alya",
          "group": "1_alya@2.1"
        },
        {
          "command": "alya.debugTest",
          "when": "resourceExtname == .alya",
          "group": "1_alya@2.2"
        },
        {
          "command": "alya.viewAssembly",
          "when": "resourceExtname == .alya",
          "group": "1_alya@3"
        },
        {
          "command": "alya.viewAst",
          "when": "resourceExtname == .alya",
          "group": "1_alya@4"
        },
        {
          "command": "alya.openRepl",
          "when": "resourceExtname == .alya",
          "group": "1_alya@5"
        },
        {
          "command": "alya.generateDocstring",
          "when": "resourceExtname == .alya",
          "group": "1_alya@6"
        },
        {
          "command": "alya.lintFile",
          "when": "resourceExtname == .alya",
          "group": "1_alya@7"
        },
        {
          "command": "alya.lintFix",
          "when": "resourceExtname == .alya",
          "group": "1_alya@8"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "alya.lsp.path": {
          "type": "string",
          "default": "alya",
          "description": "%config.lsp.path%"
        },
        "alya.lsp.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "%config.lsp.arguments%"
        },
        "alya.run.memTrace": {
          "type": "boolean",
          "default": false,
          "description": "%config.run.memTrace%"
        },
        "alya.lint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.lint.enabled%"
        },
        "alya.lint.runOnSave": {
          "type": "boolean",
          "default": false,
          "description": "%config.lint.runOnSave%"
        },
        "alya.testing.autoRunOnSave": {
          "type": "boolean",
          "default": false,
          "description": "%config.testing.autoRunOnSave%"
        },
        "alya.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.inlayHints.enabled%"
        },
        "alya.debug.path": {
          "type": "string",
          "default": "alya",
          "description": "%config.debug.path%"
        },
        "alya.rainbowBrackets": {
          "type": "boolean",
          "default": true,
          "description": "%config.rainbowBrackets%"
        }
      }
    },
    "configurationDefaults": {
      "[alya]": {
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active"
      }
    },
    "walkthroughs": [
      {
        "id": "alya.getStarted",
        "title": "%walkthrough.getStarted.title%",
        "description": "%walkthrough.getStarted.description%",
        "steps": [
          {
            "id": "checkCompiler",
            "title": "%walkthrough.step1.title%",
            "description": "%walkthrough.step1.description%",
            "media": {
              "image": {
                "dark": "./media/walkthrough/step1-terminal-dark.svg",
                "light": "./media/walkthrough/step1-terminal-light.svg",
                "hc": "./media/walkthrough/step1-terminal-dark.svg",
                "hcLight": "./media/walkthrough/step1-terminal-light.svg"
              },
              "altText": "%walkthrough.step1.alt%"
            },
            "completionEvents": ["onCommand:alya.checkCompiler"]
          },
          {
            "id": "openFile",
            "title": "%walkthrough.step2.title%",
            "description": "%walkthrough.step2.description%",
            "media": {
              "image": {
                "dark": "./media/walkthrough/step2-file-dark.svg",
                "light": "./media/walkthrough/step2-file-light.svg",
                "hc": "./media/walkthrough/step2-file-dark.svg",
                "hcLight": "./media/walkthrough/step2-file-light.svg"
              },
              "altText": "%walkthrough.step2.alt%"
            },
            "completionEvents": ["onContext:resourceLangId == alya"]
          },
          {
            "id": "runFile",
            "title": "%walkthrough.step3.title%",
            "description": "%walkthrough.step3.description%",
            "media": {
              "image": {
                "dark": "./media/walkthrough/step3-run-dark.svg",
                "light": "./media/walkthrough/step3-run-light.svg",
                "hc": "./media/walkthrough/step3-run-dark.svg",
                "hcLight": "./media/walkthrough/step3-run-light.svg"
              },
              "altText": "%walkthrough.step3.alt%"
            },
            "completionEvents": ["onCommand:alya.runFile"]
          },
          {
            "id": "themeAndTest",
            "title": "%walkthrough.step4.title%",
            "description": "%walkthrough.step4.description%",
            "media": {
              "image": {
                "dark": "./media/walkthrough/step4-theme-dark.svg",
                "light": "./media/walkthrough/step4-theme-light.svg",
                "hc": "./media/walkthrough/step4-theme-dark.svg",
                "hcLight": "./media/walkthrough/step4-theme-light.svg"
              },
              "altText": "%walkthrough.step4.alt%"
            },
            "completionEvents": ["onSettingChanged:workbench.colorTheme"]
          },
          {
            "id": "learnMore",
            "title": "%walkthrough.step5.title%",
            "description": "%walkthrough.step5.description%",
            "media": {
              "image": {
                "dark": "./media/walkthrough/step5-docs-dark.svg",
                "light": "./media/walkthrough/step5-docs-light.svg",
                "hc": "./media/walkthrough/step5-docs-dark.svg",
                "hcLight": "./media/walkthrough/step5-docs-light.svg"
              },
              "altText": "%walkthrough.step5.alt%"
            },
            "completionEvents": ["onCommand:vscode.open"]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "bun build ./src/extension.ts --target=node --outfile=./out/extension.js --external vscode",
    "package": "bunx @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
