{
  "name": "alya-lsp",
  "displayName": "Alya",
  "description": "Language Server Protocol (LSP), native assembly viewer, Test Explorer, formatting, CodeLens, syntax highlighting, and brand file icons for Alya",
  "version": "0.5.0",
  "publisher": "alya-lang",
  "author": {
    "name": "Taiizor",
    "email": "taiizor@vegalya.com",
    "url": "https://github.com/Taiizor"
  },
  "license": "MIT",
  "homepage": "https://github.com/alya-lang/vscode-alya#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/alya-lang/vscode-alya.git"
  },
  "bugs": {
    "url": "https://github.com/alya-lang/vscode-alya/issues"
  },
  "keywords": [
    "alya",
    "lsp",
    "language-server",
    "syntax-highlighting",
    "programming-language",
    "assembly",
    "testing"
  ],
  "icon": "./icons/alya-icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters",
    "Testing"
  ],
  "activationEvents": [
    "onLanguage:alya"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "alya",
        "aliases": [
          "Alya",
          "alya"
        ],
        "extensions": [
          ".alya"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./icons/alya-file-dark.svg",
          "light": "./icons/alya-file-light.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "alya",
        "scopeName": "source.alya",
        "path": "./syntaxes/alya.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "alya",
        "path": "./snippets/alya.json"
      }
    ],
    "iconThemes": [
      {
        "id": "alya-icons",
        "label": "Alya File Icons",
        "path": "./icons/alya-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "alya.runFile",
        "title": "Alya: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "alya.runFileWithMemTrace",
        "title": "Alya: Run with Memory Trace (--mem-trace)",
        "icon": "$(pulse)"
      },
      {
        "command": "alya.runTest",
        "title": "Alya: Run Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "alya.viewAssembly",
        "title": "Alya: View Assembly Output (-S)",
        "icon": "$(file-binary)"
      },
      {
        "command": "alya.viewAst",
        "title": "Alya: View Abstract Syntax Tree (AST)",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "alya.viewTokens",
        "title": "Alya: View Tokens (Lexer)",
        "icon": "$(symbol-key)"
      },
      {
        "command": "alya.showMenu",
        "title": "Alya: Open Quick Actions Menu"
      },
      {
        "command": "alya.restartLsp",
        "title": "Alya: Restart Language Server",
        "icon": "$(refresh)"
      },
      {
        "command": "alya.openRepl",
        "title": "Alya: Open REPL",
        "icon": "$(terminal)"
      },
      {
        "command": "alya.formatDocument",
        "title": "Alya: Format Document"
      },
      {
        "command": "alya.showDoc",
        "title": "Alya: Generate Documentation",
        "icon": "$(book)"
      },
      {
        "command": "alya.generateDocstring",
        "title": "Alya: Generate Docstring (Summary)",
        "icon": "$(comment)"
      },
      {
        "command": "alya.lintFile",
        "title": "Alya: Lint Current File",
        "icon": "$(search)"
      },
      {
        "command": "alya.lintFix",
        "title": "Alya: Lint and Fix Current File",
        "icon": "$(wrench)"
      },
      {
        "command": "alya.runTestAtCursor",
        "title": "Alya: Run Test at Cursor",
        "icon": "$(beaker)"
      },
      {
        "command": "alya.debugTest",
        "title": "Alya: Debug Test at Cursor / Active File",
        "icon": "$(debug-alt)"
      },
      {
        "command": "alya.rerunFailedTests",
        "title": "Alya: Re-run Failed Tests",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "alya.generateDocstring",
        "key": "ctrl+alt+d",
        "when": "editorTextFocus && editorLangId == alya"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "alya.runFile",
          "when": "resourceExtname == .alya",
          "group": "navigation@1"
        },
        {
          "command": "alya.runFileWithMemTrace",
          "when": "resourceExtname == .alya",
          "group": "navigation@1.5"
        },
        {
          "command": "alya.runTest",
          "when": "resourceExtname == .alya",
          "group": "navigation@2"
        },
        {
          "command": "alya.viewAssembly",
          "when": "resourceExtname == .alya",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "alya.runFile",
          "when": "resourceExtname == .alya",
          "group": "1_alya@1"
        },
        {
          "command": "alya.runFileWithMemTrace",
          "when": "resourceExtname == .alya",
          "group": "1_alya@1.5"
        },
        {
          "command": "alya.runTest",
          "when": "resourceExtname == .alya",
          "group": "1_alya@2"
        },
        {
          "command": "alya.runTestAtCursor",
          "when": "resourceExtname == .alya",
          "group": "1_alya@2.1"
        },
        {
          "command": "alya.debugTest",
          "when": "resourceExtname == .alya",
          "group": "1_alya@2.2"
        },
        {
          "command": "alya.viewAssembly",
          "when": "resourceExtname == .alya",
          "group": "1_alya@3"
        },
        {
          "command": "alya.viewAst",
          "when": "resourceExtname == .alya",
          "group": "1_alya@4"
        },
        {
          "command": "alya.openRepl",
          "when": "resourceExtname == .alya",
          "group": "1_alya@5"
        },
        {
          "command": "alya.generateDocstring",
          "when": "resourceExtname == .alya",
          "group": "1_alya@6"
        },
        {
          "command": "alya.lintFile",
          "when": "resourceExtname == .alya",
          "group": "1_alya@7"
        },
        {
          "command": "alya.lintFix",
          "when": "resourceExtname == .alya",
          "group": "1_alya@8"
        }
      ]
    },
    "configuration": {
      "title": "Alya",
      "properties": {
        "alya.lsp.path": {
          "type": "string",
          "default": "alya",
          "description": "Path to the alya executable"
        },
        "alya.lsp.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Arguments to pass to the alya command to start the language server"
        },
        "alya.run.memTrace": {
          "type": "boolean",
          "default": false,
          "description": "Always pass --mem-trace to 'alya run' for memory diagnostics and leak detection"
        },
        "alya.lint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time static code analysis and linter diagnostics in language server"
        },
        "alya.lint.runOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run 'alya lint --fix' when saving an Alya source file"
        },
        "alya.testing.autoRunOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically re-run package tests when an Alya source file is saved"
        }
      }
    }
  },
  "scripts": {
    "build": "bun build ./src/extension.ts --target=node --outfile=./out/extension.js --external vscode",
    "package": "bunx @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
